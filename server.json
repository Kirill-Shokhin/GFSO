{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Kirill-Shokhin/gfso",
  "description": "AI agents carry a plan to a verified result: checks fixed first, run in Docker, signed by another.",
  "repository": {
    "url": "https://github.com/Kirill-Shokhin/GFSO",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "gfso",
      "version": "0.4.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "connect"
        }
      ]
    }
  ]
}
